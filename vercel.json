{
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "audio": false
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "markets-desk-eg.vercel.app"
        }
      ],
      "destination": "/desk/egypt/",
      "permanent": false
    },
    {
      "source": "/desk/:path([a-z0-9/-]*)",
      "has": [
        {
          "type": "host",
          "value": "daily-newsletter-eg.vercel.app"
        }
      ],
      "destination": "https://markets-desk-eg.vercel.app/desk/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/podcast/heart.xml",
      "destination": "/data/audio/feed-heart.xml"
    },
    {
      "source": "/podcast/michael.xml",
      "destination": "/data/audio/feed-michael.xml"
    },
    {
      "source": "/podcast/cover.png",
      "destination": "/data/audio/cover.png"
    }
  ],
  "headers": [
    {
      "source": "/podcast/(.*).xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%s | grep -q '\\[no deploy\\]'"
}
